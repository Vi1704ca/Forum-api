// use prisma-8

model Post {
  id         Int       @id @default(autoincrement())
  title      String    @unique
  content    String
  authorName String?   @map("author")
  authorId   Int?
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String @map("hashPassword")
  posts        Post[]
}
