// use prisma-8

model Post {
  id         Int      @id @default(autoincrement())
  title      String   @unique
  content    String
  author     String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts Post[]
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  hashPassword String
}
